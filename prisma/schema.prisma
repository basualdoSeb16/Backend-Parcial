generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model user {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)
}

model book {
  id            Int      @id @default(autoincrement())
  title         String @unique
  author        String
  publishedYear Int 
  categorId     Int
  price         Float
  quantity      Int @default(0)
  category      category @relation(fields: [categorId], references: [id])

  @@index([categorId], map: "book_categorId_fkey")
}

model category {
  id    Int    @id @default(autoincrement())
  name  String
  books book[]
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}
